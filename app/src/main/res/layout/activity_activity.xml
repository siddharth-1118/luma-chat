<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnBackActivity"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:text="‹"
                android:textSize="36sp"
                android:textColor="@color/midnight_navy"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Activity"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="@color/midnight_navy"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:gravity="center"
            android:text="☎\n\nYour connections,\nall in one place"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/midnight_navy"
            android:background="@drawable/button_background"
            android:layout_marginTop="14dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recent Calls"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="@color/midnight_navy"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="14dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/input_field">

            <TextView
                android:id="@+id/filterAll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="All"
                android:textStyle="bold"
                android:textColor="@color/midnight_navy"/>

            <TextView
                android:id="@+id/filterIncoming"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Incoming"
                android:textColor="@color/text_secondary"/>

            <TextView
                android:id="@+id/filterOutgoing"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Outgoing"
                android:textColor="@color/text_secondary"/>

            <TextView
                android:id="@+id/filterMissed"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Missed"
                android:textColor="@color/text_secondary"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/callList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp">

            <include layout="@layout/call_item"/>
            <include layout="@layout/call_item"/>
            <include layout="@layout/call_item"/>
            <include layout="@layout/call_item"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>