<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:text="‹"
                android:textSize="34sp"
                android:gravity="center"
                android:textColor="@color/midnight_navy"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Inbox"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/midnight_navy"/>

            <TextView
                android:id="@+id/btnP2PInbox"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="🌐"
                android:textSize="22sp"
                android:gravity="center"
                android:textColor="@color/midnight_navy"
                android:background="@drawable/input_field"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:text="⌕"
                android:textSize="28sp"
                android:gravity="center"
                android:textColor="@color/midnight_navy"/>

        </LinearLayout>

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your conversations, all in one place."
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginStart="45dp"
            android:layout_marginBottom="22dp"/>

        <!-- Search -->
        <EditText
            android:id="@+id/etInboxSearch"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Search conversations..."
            android:padding="14dp"
            android:singleLine="true"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:background="@drawable/input_field"/>

        <!-- Live Connected Users Tray -->
        <LinearLayout
            android:id="@+id/layoutOnlineSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Online friends"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/midnight_navy" />

                <TextView
                    android:id="@+id/tvOnlineCountBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:background="@drawable/button_background"
                    android:text="0 active"
                    android:textSize="10sp"
                    android:textColor="@color/midnight_navy" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/onlineUsersContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Filters -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tabAll"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:paddingHorizontal="24dp"
                android:gravity="center"
                android:text="All"
                android:textColor="@color/midnight_navy"
                android:textStyle="bold"
                android:background="@drawable/button_background"/>

            <TextView
                android:id="@+id/tabUnread"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:paddingHorizontal="20dp"
                android:gravity="center"
                android:text="Unread"
                android:textColor="@color/midnight_navy"
                android:layout_marginStart="10dp"
                android:background="@drawable/input_field"/>

            <TextView
                android:id="@+id/tabPinned"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:paddingHorizontal="20dp"
                android:gravity="center"
                android:text="Pinned"
                android:textColor="@color/midnight_navy"
                android:layout_marginStart="10dp"
                android:background="@drawable/input_field"/>

        </LinearLayout>

        <!-- Empty State -->
        <TextView
            android:id="@+id/tvEmptyInbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="32dp"
            android:text="No conversations found.\nTap '+' to start a new chat!"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Conversation List -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/conversationListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

    </LinearLayout>

    <!-- New Chat Button -->
    <TextView
        android:id="@+id/btnNewChat"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:gravity="center"
        android:text="+"
        android:textSize="32sp"
        android:textColor="@color/card_white"
        android:background="@drawable/button_background"/>

</FrameLayout>