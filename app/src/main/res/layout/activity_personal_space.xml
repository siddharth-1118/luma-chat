<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnBackPersonal"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:text="‹"
                android:textSize="36sp"
                android:textColor="@color/midnight_navy"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Personal Space"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/midnight_navy"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:background="@drawable/card_background"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/tvPersonalAvatar"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:gravity="center"
                android:text="H"
                android:textSize="42sp"
                android:textStyle="bold"
                android:textColor="@color/midnight_navy"
                android:background="@drawable/button_background"/>

            <TextView
                android:id="@+id/tvPersonalName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Harshitha"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/midnight_navy"
                android:layout_marginTop="12dp"/>

            <TextView
                android:id="@+id/tvPersonalBio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Making memories, one message at a time ✨"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="6dp"/>

            <TextView
                android:id="@+id/btnEditProfile"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="✎  Edit Profile"
                android:textColor="@color/midnight_navy"
                android:textStyle="bold"
                android:paddingHorizontal="20dp"
                android:background="@drawable/input_field"
                android:layout_marginTop="16dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="105dp"
            android:orientation="horizontal"
            android:layout_marginTop="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:layout_marginEnd="5dp">

                <TextView
                    android:id="@+id/tvTotalChats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/midnight_navy"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Chats"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:layout_marginHorizontal="5dp">

                <TextView
                    android:id="@+id/tvTotalGroups"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/midnight_navy"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Groups"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:layout_marginStart="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="128"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/midnight_navy"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Days Active"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Space"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/midnight_navy"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/menuMyActivity"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="18dp"
            android:text="◷     My Activity                         ›"
            android:textSize="15sp"
            android:textColor="@color/midnight_navy"
            android:background="@drawable/card_background"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/menuSaved"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="18dp"
            android:text="♡     Saved Messages                 ›"
            android:textSize="15sp"
            android:textColor="@color/midnight_navy"
            android:background="@drawable/card_background"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/menuFiles"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="18dp"
            android:text="▤     My Files                             ›"
            android:textSize="15sp"
            android:textColor="@color/midnight_navy"
            android:background="@drawable/card_background"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/menuMedia"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="18dp"
            android:text="▧     Shared Media                     ›"
            android:textSize="15sp"
            android:textColor="@color/midnight_navy"
            android:background="@drawable/card_background"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/btnOpenSettings"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="18dp"
            android:text="⚙     Settings                           ›"
            android:textSize="15sp"
            android:textColor="@color/midnight_navy"
            android:background="@drawable/card_background"
            android:layout_marginBottom="10dp"/>

    </LinearLayout>
</ScrollView>