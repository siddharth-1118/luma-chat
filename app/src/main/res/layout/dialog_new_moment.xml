<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="22dp"
    android:background="@drawable/card_background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Post a Moment"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/midnight_navy" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Share a snapshot of your day."
        android:textSize="12sp"
        android:textColor="@color/text_secondary" />

    <EditText
        android:id="@+id/etMomentEmoji"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/input_field"
        android:hint="Mood emoji (e.g. 🌸, 🌅, ☕, ✨, 🍕, 🎧)"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="14sp"
        android:singleLine="true" />

    <EditText
        android:id="@+id/etMomentCaption"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/input_field"
        android:hint="What's happening right now?"
        android:gravity="top|start"
        android:padding="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancelMoment"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:paddingHorizontal="18dp"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSubmitMoment"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:layout_marginStart="10dp"
            android:paddingHorizontal="24dp"
            android:text="Share"
            android:textColor="@color/midnight_navy"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/button_background" />
    </LinearLayout>

</LinearLayout>
