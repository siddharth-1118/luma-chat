<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="20dp">

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/storyProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="10dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/lavender" />

    <!-- Story Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/tvStoryAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="A"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/midnight_navy"
            android:background="@drawable/button_background" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:id="@+id/tvStoryAuthor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ananya"
                android:textColor="@color/midnight_navy"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvStoryTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 hours ago"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnCloseStory"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="✕"
            android:textSize="20sp"
            android:textColor="@color/midnight_navy"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Story Body Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginVertical="24dp"
        android:padding="28dp"
        android:background="@drawable/card_background">

        <TextView
            android:id="@+id/tvStoryEmoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌸"
            android:textSize="80sp" />

        <TextView
            android:id="@+id/tvStoryCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="Enjoying the fresh cherry blossoms on this lovely morning! 🌸🍃"
            android:textSize="18sp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/midnight_navy" />

        <TextView
            android:id="@+id/tvStoryLikes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="♡ 14 likes"
            android:textSize="13sp"
            android:textColor="@color/soft_peach"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Story Reply Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/input_field"
        android:paddingHorizontal="14dp">

        <EditText
            android:id="@+id/etStoryReply"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Reply to story..."
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:singleLine="true"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnSendStoryReply"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="➤"
            android:textSize="18sp"
            android:textColor="@color/midnight_navy"
            android:background="@drawable/button_background" />
    </LinearLayout>

</LinearLayout>
