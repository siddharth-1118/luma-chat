<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="15dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/card_background">

    <TextView
        android:id="@+id/callAvatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="A"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/midnight_navy"
        android:background="@drawable/input_field"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="13dp">

        <TextView
            android:id="@+id/callName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ananya Sharma"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/midnight_navy"/>

        <TextView
            android:id="@+id/callDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Incoming • 10:30 AM"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/callType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="↙"
        android:textSize="23sp"
        android:textColor="#58B88A"/>
</LinearLayout>