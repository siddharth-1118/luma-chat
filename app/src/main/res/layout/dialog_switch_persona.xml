<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="22dp"
    android:background="@drawable/card_background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Switch Active Persona"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/midnight_navy" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Switch identities to test two-way chats on one device."
        android:textSize="12sp"
        android:textColor="@color/text_secondary" />

    <LinearLayout
        android:id="@+id/personaHarshitha"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:background="@drawable/input_field"
        android:layout_marginTop="16dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="H"
            android:textStyle="bold"
            android:textColor="@color/midnight_navy"
            android:background="@drawable/button_background" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="Harshitha (Primary User)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/midnight_navy" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/personaAnanya"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:background="@drawable/input_field"
        android:layout_marginTop="10dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="A"
            android:textStyle="bold"
            android:textColor="@color/midnight_navy"
            android:background="@drawable/button_background" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="Ananya Sharma"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/midnight_navy" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/personaRahul"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:background="@drawable/input_field"
        android:layout_marginTop="10dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="R"
            android:textStyle="bold"
            android:textColor="@color/midnight_navy"
            android:background="@drawable/button_background" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="Rahul"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/midnight_navy" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnClosePersona"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="end"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:text="Cancel"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
