<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnBackSettings"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:text="‹"
                android:textSize="36sp"
                android:textColor="@color/midnight_navy"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="@color/midnight_navy"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="105dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="@drawable/button_background"
            android:layout_marginTop="15dp">

            <TextView
                android:id="@+id/tvSettingsAvatar"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:gravity="center"
                android:text="H"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="@color/midnight_navy"
                android:background="@drawable/card_background"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="15dp">

                <TextView
                    android:id="@+id/tvSettingsName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Harshitha"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/midnight_navy"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manage your profile"
                    android:textSize="12sp"
                    android:textColor="@color/midnight_navy"
                    android:layout_marginTop="5dp"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preferences"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="@color/midnight_navy"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="@drawable/card_background">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🌙   Dark Theme"
                android:textSize="15sp"
                android:textColor="@color/midnight_navy"/>

            <Switch
                android:id="@+id/switchTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Account &amp; Privacy"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="@color/midnight_navy"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/settingAccount"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:text="👤   Account                              ›"
            android:textSize="15sp"
            android:textColor="@color/midnight_navy"
            android:background="@drawable/card_background"
            android:layout_marginBottom="9dp"/>

        <TextView
            android:id="@+id/settingPrivacy"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:text="🔒   Privacy &amp; Security              ›"
            android:textSize="15sp"
            android:textColor="@color/midnight_navy"
            android:background="@drawable/card_background"
            android:layout_marginBottom="9dp"/>

        <TextView
            android:id="@+id/settingNotifications"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:text="🔔   Notifications                       ›"
            android:textSize="15sp"
            android:textColor="@color/midnight_navy"
            android:background="@drawable/card_background"
            android:layout_marginBottom="9dp"/>

        <TextView
            android:id="@+id/settingAppearance"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:text="🎨   Chat Appearance                ›"
            android:textSize="15sp"
            android:textColor="@color/midnight_navy"
            android:background="@drawable/card_background"
            android:layout_marginBottom="9dp"/>

        <TextView
            android:id="@+id/settingStorage"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:text="▤   Data &amp; Storage                    ›"
            android:textSize="15sp"
            android:textColor="@color/midnight_navy"
            android:background="@drawable/card_background"
            android:layout_marginBottom="9dp"/>

        <TextView
            android:id="@+id/settingHelp"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:text="♡   Help &amp; Security               ›"
            android:textSize="15sp"
            android:textColor="@color/midnight_navy"
            android:background="@drawable/card_background"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>
</ScrollView>