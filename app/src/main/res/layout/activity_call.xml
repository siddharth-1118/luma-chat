<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/background"
    android:padding="24dp">

    <!-- Top Call Badge -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="20dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:background="@drawable/input_field">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒  LumaVoice • Encrypted"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Avatar -->
    <TextView
        android:id="@+id/tvCallAvatar"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:gravity="center"
        android:text="A"
        android:textSize="48sp"
        android:textStyle="bold"
        android:textColor="@color/midnight_navy"
        android:background="@drawable/button_background" />

    <!-- Name -->
    <TextView
        android:id="@+id/tvCallName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Ananya Sharma"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/midnight_navy" />

    <!-- Call Status / Timer -->
    <TextView
        android:id="@+id/tvCallTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Connecting..."
        android:textSize="16sp"
        android:textColor="@color/text_secondary" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2" />

    <!-- In-Call Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="36dp">

        <!-- Mute -->
        <LinearLayout
            android:id="@+id/btnMute"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/iconMute"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:gravity="center"
                android:text="🎤"
                android:textSize="22sp"
                android:background="@drawable/call_btn_round" />

            <TextView
                android:id="@+id/lblMute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Mute"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- Speaker -->
        <LinearLayout
            android:id="@+id/btnSpeaker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/iconSpeaker"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:gravity="center"
                android:text="🔊"
                android:textSize="22sp"
                android:background="@drawable/call_btn_round" />

            <TextView
                android:id="@+id/lblSpeaker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Speaker"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- Keypad -->
        <LinearLayout
            android:id="@+id/btnKeypad"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:gravity="center"
                android:text="⌨"
                android:textSize="22sp"
                android:background="@drawable/call_btn_round" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Keypad"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

    </LinearLayout>

    <!-- End Call Button -->
    <TextView
        android:id="@+id/btnEndCall"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="28dp"
        android:gravity="center"
        android:text="✕"
        android:textSize="28sp"
        android:textColor="@color/card_white"
        android:background="@drawable/call_end_btn"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
